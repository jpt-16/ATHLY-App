# dependencies
node_modules/

# build output
dist/
dist-ssr/
*.local

# test / tooling caches
coverage/
.vite/
*.tsbuildinfo

# environment
.env
.env.*
# ...but the template carries no values, and someone cloning this needs it.
!.env.example

# editors
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.swp

# visual harness working files (the baselines are committed; these are not)
tools/visual/.capture/
tools/visual/.capture-auth/
tools/visual/diffs/
tools/visual/diffs-auth/

# supabase cli local state
supabase/.branches/
supabase/.temp/

# usda ingest working file — regenerated on every run and only useful while you
# are picking matches. The choices themselves live in matches.json, which is
# committed, because those are the numbers anyone would want to audit.
tools/usda/candidates.json
