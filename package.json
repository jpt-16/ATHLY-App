{
  "name": "athly-app",
  "version": "0.1.0",
  "private": true,
  "description": "ATHLY — nutrition planning for athletes. Interactive product prototype.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --build --force && vite build",
    "build:local": "tsc --build --force && node tools/build-local.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "test:roundtrip": "vitest run --config vitest.roundtrip.config.ts",
    "test:visual": "node tools/visual/run.mjs",
    "test:visual:update": "node tools/visual/run.mjs --update",
    "test:visual:auth": "node tools/visual/run-auth.mjs",
    "test:visual:auth:update": "node tools/visual/run-auth.mjs --update",
    "visual:docker": "docker run --rm -t -v \"$PWD\":/work -w /work -e HOME=/tmp -u \"$(id -u):$(id -g)\" mcr.microsoft.com/playwright:v1.62.1-noble",
    "test:visual:docker": "npm run visual:docker -- npm run test:visual",
    "test:visual:update:docker": "npm run visual:docker -- npm run test:visual:update",
    "icons": "node tools/icons/generate.mjs",
    "ios": "npm run ios:sync && npx cap open ios",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:assets": "npx capacitor-assets generate --ios",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build:local"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.1.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.3",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@supabase/supabase-js": "^2.112.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^9.39.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
