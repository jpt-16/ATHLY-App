# ATHLY — environment.
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so nothing
# secret belongs in it.
#
#   cp .env.example .env
#
# Leave it all blank and the app still runs: with no Supabase project configured
# it behaves exactly as it did before there was a backend — local state, nothing
# saved, no sign-in. A *production* build with these unset fails at startup
# rather than shipping an app that quietly persists nothing.

# Supabase → Project Settings → API.
#
# Both of these are public. They are compiled into the JavaScript bundle and
# anyone can read them out of it, which is fine and by design: the `anon` key
# grants only what Row Level Security allows, and RLS grants a signed-in user
# their own rows and nothing else.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NEVER put the `service_role` key in this file or any other VITE_ variable. It
# bypasses Row Level Security completely — every row of every table, for every
# user. Supabase injects it into Edge Functions automatically, which is the only
# place it is needed.

# `true` to offer Sign in with Apple. Requires an Apple Developer membership, a
# Services ID and a signing key configured in the Supabase dashboard; the button
# renders but cannot work without them. Apple requires this option on iOS once
# Google sign-in exists (App Store Guideline 4.8).
VITE_ENABLE_APPLE=false

# The public website's origin, e.g. https://athly.example.com — no trailing
# slash. Only needed for the iOS build: its own origin is `capacitor://localhost`,
# which no browser outside the app can open, and the privacy policy has to be
# reachable at a real URL for App Store review. In a browser this is inferred
# from the address bar and can be left blank.
VITE_SITE_URL=
